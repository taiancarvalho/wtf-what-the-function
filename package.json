{
  "name": "wtf",
  "productName": "WTF — What The Function",
  "version": "0.1.0",
  "private": true,
  "description": "Entenda o que a IA está construindo no seu software, sem saber programar.",
  "license": "MIT",
  "author": "Taian Carvalho",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5273 && electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node bin/wtf.mjs",
    "dev:app": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5273 && electron .\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/instrument-sans": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "bin": {
    "wtf": "bin/wtf.mjs"
  },
  "files": [
    "bin",
    "electron",
    "skill",
    "dist",
    "README.md",
    "LICENSE"
  ]
}
